# /etc/energy-archiv/.env  (chmod 600)
HA_URL=http://192.168.1.11:8123
HA_TOKEN=            # HA → profil → Zabezpečenie → Dlhodobé prístupové tokeny

DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=          # prihlasovací e-mail do Deye Cloud
DEYE_PASSWORD=       # alebo DEYE_PASSWORD_SHA256=<sha256 hesla>

WEB_PASSWORD=        # voliteľné heslo do web rozhrania
