# /etc/energy-archiv/.env  (chmod 600)
# HA → profil → Zabezpečenie → Dlhodobé prístupové tokeny
HA_URL=http://192.168.1.11:8123
HA_TOKEN=

# Deye Cloud (developer.deyecloud.com) a prihlásenie do aplikácie
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
# alebo namiesto hesla: DEYE_PASSWORD_SHA256=<sha256 hesla>

# Voliteľné heslo do web rozhrania (prázdne = bez hesla)
WEB_PASSWORD=
